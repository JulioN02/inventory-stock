# Backend environment — copy to .env and adjust (never commit .env)
NODE_ENV=development
PORT=3000

# PostgreSQL 16 via docker compose (host port 55434)
DATABASE_URL=postgres://postgres:postgres@localhost:55434/inventory_stock

# Secrets — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# MUST be at least 32 characters (HS256)
JWT_SECRET=change-me-please-generate-48-random-bytes-hex
COOKIE_SECRET=change-me-please-generate-48-random-bytes-hex

# Same-origin in dev via Vite proxy; kept as escape hatch only
CORS_ORIGIN=http://localhost:5173

# Admin bootstrap (scripts/seed.ts) — password never committed
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password
ADMIN_EMAIL=admin@example.com